{
  "name": "point-of-sale",
  "private": false,
  "version": "1.0.0",
  "description": "Point of Sale — an open-source point-of-sale example app for cafes & restaurants, built with Vite + React + TypeScript.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "vite build --base=/demo/point-of-sale/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:status": "node db/demo.mjs status",
    "demo:import": "node db/demo.mjs import",
    "demo:wipe": "node db/demo.mjs wipe",
    "demo:reset": "node db/demo.mjs reset"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  }
}
