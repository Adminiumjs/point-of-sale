{
  "manifestVersion": 1,
  "key": "pos",
  "name": "Point of Sale",
  "version": "1.0.0",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.pos.desc",
    "fallback": "Point-of-sale terminal and back-office for cafes and restaurants — menu, tickets, split payments, floor plan, and staff shifts, over one shared database."
  },
  "categories": [
    "hospitality"
  ],
  "compatibility": {
    "minAdminiumVersion": "1.0.0",
    "engines": [
      "sqlite",
      "postgres"
    ],
    "requires": [
      "realtime"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "menuitems",
        "columns": [
          {
            "ref": "id",
            "type": "int"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "price",
            "type": "money"
          },
          {
            "ref": "category",
            "type": "text"
          },
          {
            "ref": "imageurl",
            "type": "text",
            "semantic": "image"
          },
          {
            "ref": "available",
            "type": "bool"
          }
        ]
      },
      {
        "ref": "tables",
        "columns": [
          {
            "ref": "id",
            "type": "int"
          },
          {
            "ref": "label",
            "type": "text"
          },
          {
            "ref": "seats",
            "type": "int"
          },
          {
            "ref": "zone",
            "type": "text"
          }
        ]
      },
      {
        "ref": "tickets",
        "columns": [
          {
            "ref": "id",
            "type": "int"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "tables",
            "type": "fk",
            "nullable": true,
            "references": "tables"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "open",
              "sent",
              "paid",
              "void"
            ]
          },
          {
            "ref": "total",
            "type": "money"
          },
          {
            "ref": "openedat",
            "type": "timestamptz"
          },
          {
            "ref": "closedat",
            "type": "timestamptz",
            "nullable": true
          }
        ]
      },
      {
        "ref": "ticketitems",
        "columns": [
          {
            "ref": "id",
            "type": "int"
          },
          {
            "ref": "tickets",
            "type": "fk",
            "references": "tickets"
          },
          {
            "ref": "menuitems",
            "type": "fk",
            "references": "menuitems"
          },
          {
            "ref": "qty",
            "type": "int"
          },
          {
            "ref": "unitprice",
            "type": "money"
          },
          {
            "ref": "notes",
            "type": "text",
            "nullable": true
          }
        ]
      },
      {
        "ref": "payments",
        "columns": [
          {
            "ref": "id",
            "type": "int"
          },
          {
            "ref": "tickets",
            "type": "fk",
            "references": "tickets"
          },
          {
            "ref": "method",
            "type": "enum",
            "enum": [
              "cash",
              "card",
              "qr"
            ]
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "paidat",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "shifts",
        "columns": [
          {
            "ref": "id",
            "type": "int"
          },
          {
            "ref": "staff",
            "type": "text"
          },
          {
            "ref": "startedat",
            "type": "timestamptz"
          },
          {
            "ref": "endedat",
            "type": "timestamptz",
            "nullable": true
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "pos-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.pos.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "gauge",
        "order": 1
      }
    },
    {
      "ref": "pos-menu",
      "template": "page-crud",
      "title": {
        "key": "mft.pos.page.menu",
        "fallback": "Menu"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "utensils",
        "order": 2
      }
    },
    {
      "ref": "pos-tickets",
      "template": "page-master-detail",
      "title": {
        "key": "mft.pos.page.tickets",
        "fallback": "Tickets"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "receipt",
        "order": 3
      }
    },
    {
      "ref": "pos-shifts",
      "template": "page-scheduler",
      "title": {
        "key": "mft.pos.page.shifts",
        "fallback": "Shifts"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "calendar-clock",
        "order": 4
      }
    }
  ],
  "capabilities": [
    "offline-required",
    "receipt-printer",
    "barcode-scanner",
    "payments",
    "realtime"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "electron",
      "entry": "index.html",
      "routes": {
        "pos": "/"
      }
    }
  ]
}
