{
  "manifestVersion": 1,
  "key": "pos",
  "name": "Point of Sale",
  "version": "0.1.1",
  "publisher": {
    "id": "adminium",
    "name": "Adminium",
    "url": "https://adminium.dev"
  },
  "license": "AGPL-3.0-only",
  "description": {
    "key": "mft.pos.desc",
    "fallback": "Point-of-sale terminal and back-office for cafes and restaurants — menu, tickets, split payments, floor plan, and staff shifts, over one shared database."
  },
  "categories": [
    "hospitality"
  ],
  "compatibility": {
    "minAdminiumVersion": "0.2.8",
    "engines": [
      "sqlite",
      "postgres"
    ],
    "requires": [
      "realtime"
    ]
  },
  "requiredSchema": {
    "tables": [
      {
        "ref": "menu_items",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "name",
            "type": "text"
          },
          {
            "ref": "price",
            "type": "money"
          },
          {
            "ref": "category",
            "type": "text"
          },
          {
            "ref": "image_url",
            "type": "text",
            "semantic": "image",
            "nullable": true
          },
          {
            "ref": "available",
            "type": "bool"
          }
        ]
      },
      {
        "ref": "restaurant_tables",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "label",
            "type": "text"
          },
          {
            "ref": "seats",
            "type": "int"
          },
          {
            "ref": "zone",
            "type": "text"
          }
        ]
      },
      {
        "ref": "tickets",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "number",
            "type": "text"
          },
          {
            "ref": "table_id",
            "type": "fk",
            "nullable": true,
            "references": "restaurant_tables"
          },
          {
            "ref": "status",
            "type": "enum",
            "enum": [
              "open",
              "sent",
              "paid",
              "void"
            ]
          },
          {
            "ref": "total",
            "type": "money"
          },
          {
            "ref": "opened_at",
            "type": "timestamptz"
          },
          {
            "ref": "closed_at",
            "type": "timestamptz",
            "nullable": true
          }
        ]
      },
      {
        "ref": "ticket_items",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "ticket_id",
            "type": "fk",
            "references": "tickets"
          },
          {
            "ref": "menu_item_id",
            "type": "fk",
            "nullable": true,
            "references": "menu_items"
          },
          {
            "ref": "qty",
            "type": "int"
          },
          {
            "ref": "unit_price",
            "type": "money"
          },
          {
            "ref": "notes",
            "type": "text",
            "nullable": true
          }
        ]
      },
      {
        "ref": "payments",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "ticket_id",
            "type": "fk",
            "references": "tickets"
          },
          {
            "ref": "method",
            "type": "enum",
            "enum": [
              "cash",
              "card",
              "qr"
            ]
          },
          {
            "ref": "amount",
            "type": "money"
          },
          {
            "ref": "paid_at",
            "type": "timestamptz"
          }
        ]
      },
      {
        "ref": "shifts",
        "columns": [
          {
            "ref": "id",
            "type": "int",
            "role": "pk"
          },
          {
            "ref": "staff",
            "type": "text"
          },
          {
            "ref": "started_at",
            "type": "timestamptz"
          },
          {
            "ref": "ended_at",
            "type": "timestamptz",
            "nullable": true
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "ref": "pos-dashboard",
      "template": "page-dashboard",
      "title": {
        "key": "mft.pos.page.dashboard",
        "fallback": "Dashboard"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "gauge",
        "order": 1
      }
    },
    {
      "ref": "pos-menu",
      "template": "page-crud",
      "title": {
        "key": "mft.pos.page.menu",
        "fallback": "Menu"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "utensils",
        "order": 2
      }
    },
    {
      "ref": "pos-tickets",
      "template": "page-master-detail",
      "title": {
        "key": "mft.pos.page.tickets",
        "fallback": "Tickets"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "receipt",
        "order": 3
      }
    },
    {
      "ref": "pos-shifts",
      "template": "page-scheduler",
      "title": {
        "key": "mft.pos.page.shifts",
        "fallback": "Shifts"
      },
      "nav": {
        "group": "manifest:pos",
        "icon": "calendar-clock",
        "order": 4
      }
    }
  ],
  "capabilities": [
    "offline-required",
    "receipt-printer",
    "barcode-scanner",
    "payments",
    "realtime"
  ],
  "kind": "app",
  "frontends": [
    {
      "side": "staff",
      "kind": "spa",
      "entry": "index.html",
      "env": {
        "VITE_ADMINIUM_API_BASE_URL": {
          "required": false,
          "example": "https://admin.example.com"
        },
        "VITE_ADMINIUM_PUBLISHABLE_KEY": {
          "required": false,
          "example": "adm_pub_..."
        }
      },
      "routes": {
        "pos": "/"
      }
    }
  ]
}
