# Copy to `.env` and fill in before `docker compose up` in any non-local setup.
#
# Adminium session/crypto secret. MUST be a real 32-byte hex string in
# production — generate one with:  openssl rand -hex 32
# If left blank, docker-compose.yml falls back to an insecure dev default that
# must never be used for a real deployment.
ADMINIUM_SECRET=

# Load the demo data on first boot? Default 1 (yes) — the app comes up with a
# working set of realistic rows. Set to 0 to start with an empty database that
# still has the full schema. Either way you can change your mind later:
#   npm run demo:import   load it
#   npm run demo:wipe     remove it — your own rows and the schema stay
#   npm run demo:status   see what is loaded
DEMO_DATA=1

# ─── Connecting the front end to Adminium ────────────────────────────────────
#
# BOTH ARE READ AT BUILD TIME, not at run time. Vite inlines them into the
# bundle, so setting either after a build does nothing until the next one — with
# Docker that means `docker compose up --build`, not a restart.
#
# Leave them empty and the app builds in DEMO mode: realistic sample data
# compiled into the JavaScript, with a demo dock for switching personas. That is
# what the adminium.dev demos serve. It is not what you want on your own domain
# — nothing in it can be edited, exported or kept.
#
# Set them for a STANDALONE deployment — the app on its own domain, talking back
# to an Adminium somewhere else. Mint the key in Studio -> Public API. For this
# till that build stops at a notice instead of opening: the database has no
# staff table and no PIN column, so there is nobody it could sign in.
#
# (There is a third arrangement where Adminium serves the till itself and neither
# variable is needed, because the browser is already on Adminium's origin and
# uses your session — which is also what opens the till. Build it with
# `npm run build:surface` and point Adminium's ADMINIUM_SURFACES_DIR at
# dist-surface/.)
# The key is public by design (`adm_pub_`): it selects a scope, reads only what
# that scope lists, and is refused outside /api/v1/public. A secret `adm_sk_`
# key here would be a real leak.
VITE_ADMINIUM_API_BASE_URL=
VITE_ADMINIUM_PUBLISHABLE_KEY=
